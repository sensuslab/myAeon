# Server-side only. Do not use NEXT_PUBLIC_ prefixes for these variables.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_TIMEOUT_MS=120000

# Optional listening feature. Scripts are generated even without a Deepgram key.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=aura-2
DEEPGRAM_VOICE=thalia-en
DEEPGRAM_TIMEOUT_MS=300000
# Alternatively set DEEPGRAM_MODEL to a complete id, e.g. aura-2-thalia-en.
# A complete model id includes voice and language and overrides DEEPGRAM_VOICE.

# Self-hosted chart core. Python 3.12+ and requirements.txt are required.
# Railway's Docker image sets this automatically; local .venv is auto-detected.
# ASTROLOGY_PYTHON=/absolute/path/to/.venv/bin/python
# Stable random secret (32+ characters) signs anonymous identities and HMAC keys.
ASTROLOGY_SESSION_SECRET=
# No hosted chart key, ledger directory or generation allowance is needed.
