# Server-side only. Do not use NEXT_PUBLIC_ prefixes for these variables.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_TIMEOUT_MS=120000

# Optional listening feature. Scripts are generated even without a Deepgram key.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=aura-2
DEEPGRAM_VOICE=thalia-en
DEEPGRAM_TIMEOUT_MS=300000
# Alternatively set DEEPGRAM_MODEL to a complete id, e.g. aura-2-thalia-en.
# A complete model id includes voice and language and overrides DEEPGRAM_VOICE.

# Hosted Astrologer v6 integration (server only; RapidAPI subscription required).
ASTROLOGER_ENABLED=false
ASTROLOGER_API_KEY=
# Stable random secret (32+ characters) signs anonymous identities and HMAC keys.
ASTROLOGY_SESSION_SECRET=
# Absolute path on a persistent Railway volume. Required before paid requests.
# A single Node service owns this ledger; do not use ephemeral deployment storage.
ASTROLOGY_QUOTA_DIR=/data/astrology-quota
# Hard limit: five provider attempts per anonymous browser user in total.
# There is deliberately no env override which could exceed that limit.
